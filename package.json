{
  "name": "plataforma-gestao-projetos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "stack:up": "bash scripts/local-stack/up.sh",
    "stack:down": "bash scripts/local-stack/down.sh",
    "template": "tsx scripts/generate-template.ts",
    "build:demo": "VITE_DEMO=true vite build --outDir dist-demo",
    "build:preview-file": "VITE_DEMO=true SINGLEFILE=true vite build --outDir dist-single",
    "dev:demo": "VITE_DEMO=true vite",
    "setup-sql": "node scripts/build-setup-sql.mjs",
    "nexo:dev": "vite --config apps/nexoprocess/vite.config.ts",
    "nexo:build": "npm run nexo:typecheck && vite build --config apps/nexoprocess/vite.config.ts",
    "nexo:preview": "vite preview --config apps/nexoprocess/vite.config.ts",
    "nexo:typecheck": "tsc -p apps/nexoprocess/tsconfig.json --noEmit",
    "nexo:test": "vitest run -c apps/nexoprocess/vitest.config.ts",
    "nexo:e2e": "playwright test -c apps/nexoprocess/playwright.config.ts",
    "nexo:build:single": "SINGLEFILE=true VITE_ROUTER=hash vite build --config apps/nexoprocess/vite.config.ts",
    "nexo:build:preview-file": "npm run nexo:build:single",
    "nexo:lint": "eslint apps/nexoprocess",
    "nexo:test:unit": "vitest run -c apps/nexoprocess/vitest.config.ts",
    "nexo:check-bundle": "node apps/nexoprocess/scripts/check-bundle.mjs",
    "nexo:test:csp": "node apps/nexoprocess/scripts/test-csp.mjs",
    "nexo:test:csp:rotas": "node apps/nexoprocess/scripts/csp-routes.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "bpmn-js": "^18.31.0",
    "bpmn-moddle": "^10.3.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
