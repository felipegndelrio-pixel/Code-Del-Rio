# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# Settings > API no painel do Supabase.
# A chave "anon"/"publishable" é pública por natureza e protegida por RLS.
# NUNCA coloque a chave service_role / secret em variáveis VITE_*.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publica
