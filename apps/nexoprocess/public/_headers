# Cloudflare Pages — cabeçalhos de segurança e cache (arquivo estático, sem Functions).
# O app não chama APIs externas: connect-src fica restrito à própria origem.
# Cada diretiva está justificada em docs/security-headers.md e é verificada em CI
# por scripts/test-csp.mjs (npm run nexo:test:csp, via wrangler pages dev).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

# Páginas estáticas EN (/en/): único lugar com script de terceiros (Cloudflare Web Analytics, snippet manual).
# A regra acima (/*) soma o CSP do app; aqui ele é DESTACADO e substituído pelo CSP da landing, que só acrescenta o beacon.
# O app (/app, /entrar, /…) continua com script-src 'self'. Diretivas justificadas em docs/security-headers.md.
/en/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/en/assets/*
  Cache-Control: public, max-age=86400
